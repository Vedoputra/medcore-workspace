# PORT DATABASE DI HOST
HOST_PORT_PATIENT_DB=5432
HOST_PORT_APPOINTMENT_DB=5433
HOST_PORT_PHARMACY_DB=27017
HOST_PORT_BILLING_DB=3306

# KREDENSIAL PATIENT DB (PostgreSQL Engine 1)
PATIENT_DB_USER=usr_patient_svc
PATIENT_DB_PASS=your_patient_db_password
PATIENT_DB_NAME=medcore_patient_db

# KREDENSIAL APPOINTMENT DB (PostgreSQL Engine 2)
APPOINTMENT_DB_USER=usr_appointment_svc
APPOINTMENT_DB_PASS=your_appointment_db_password
APPOINTMENT_DB_NAME=medcore_appointment_db

# KREDENSIAL PHARMACY DB (MongoDB Engine)
MONGO_ROOT_USER=adm_pharmacy_svc
MONGO_ROOT_PASS=your_mongo_root_password
PHARMACY_DB_NAME=medcore_pharmacy_db

# KREDENSIAL BILLING DB (MySQL Engine)
BILLING_DB_USER=usr_billing_svc
BILLING_DB_PASS=your_billing_db_password
BILLING_DB_NAME=medcore_billing_db